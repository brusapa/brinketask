# Settings of the brinketask server (SPEC section 10; docs/deployment.md).
# Copy to brinketask.env, fill in, and keep it readable by its owner only
# (chmod 600): it holds secrets. Every value below is a placeholder.

# The origin users open, https and without a path.
PUBLIC_URL=https://tasks.example.com

# The database password must match db.env.
DATABASE_URL=postgres://brinketask:CHANGE-ME@db:5432/brinketask?sslmode=disable

# The OIDC client registered in Pocket ID (callback PUBLIC_URL/auth/callback).
OIDC_ISSUER=https://id.example.com
OIDC_CLIENT_ID=CHANGE-ME
OIDC_CLIENT_SECRET=CHANGE-ME

# Made once with `podman run --rm localhost/brinketask:<version> vapid-keys`
# and kept: new keys stop every device's notifications until it is turned
# on again.
VAPID_PUBLIC_KEY=CHANGE-ME
VAPID_PRIVATE_KEY=CHANGE-ME
VAPID_SUBJECT=mailto:admin@example.com

# Optional, with their defaults:
# LISTEN_ADDR=:8080
# METRICS_LISTEN_ADDR=:9090
# LOG_LEVEL=info
# SESSION_IDLE_TIMEOUT=168h
# SESSION_MAX_AGE=720h
# SCHEDULER_INTERVAL=15s
# REMINDER_MAX_LATENESS=12h
