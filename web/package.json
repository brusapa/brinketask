{
  "name": "brinketask-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "generate": "openapi-typescript ../api/openapi.yaml --output src/api/schema.gen.ts",
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.sw.json && vite build && vite build --config vite.sw.config.ts",
    "typecheck": "tsc && tsc -p tsconfig.sw.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@internationalized/date": "3.12.4",
    "@tanstack/react-query": "5.104.1",
    "fractional-indexing": "4.0.0",
    "i18next": "26.4.2",
    "lucide-react": "1.53.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-aria-components": "1.22.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.16",
    "react-markdown": "10.1.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
